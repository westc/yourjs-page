{
  "name": "yourjs-page",
  "version": "1.1.1",
  "description": "A CodePen-like HTML, CSS and JavaScript playground that you can embed on any web page with one script tag.",
  "unpkg": "dist/yourjs-page.min.js",
  "jsdelivr": "dist/yourjs-page.min.js",
  "types": "dist/yourjs-page.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "gulp build",
    "dev": "gulp dev",
    "start": "gulp",
    "test": "npm run build && node test/run.js",
    "test:webkit": "npm run build && TEST_BROWSER=webkit node test/run.js",
    "test:firefox": "npm run build && TEST_BROWSER=firefox node test/run.js",
    "test:all": "npm run build && node scripts/test-all.js",
    "release": "node scripts/release.js",
    "record-demo": "node scripts/record-demo.js",
    "og-image": "node scripts/make-og-image.js",
    "purge-cdn": "node scripts/purge-cdn.js",
    "version": "npm run build && node scripts/update-changelog.js && git add dist CHANGELOG.md",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/westc/yourjs-page.git"
  },
  "keywords": [
    "CodePen",
    "Playground",
    "HTML",
    "CSS",
    "JavaScript",
    "Editor"
  ],
  "author": "Chris West",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/westc/yourjs-page/issues"
  },
  "homepage": "https://westc.github.io/yourjs-page/",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "clean-css": "^5.3.3",
    "gulp": "^5.0.1",
    "html-minifier-terser": "^7.2.0",
    "playwright-core": "^1.63.0",
    "terser": "^5.46.0"
  },
  "engines": {
    "node": ">=20"
  }
}
